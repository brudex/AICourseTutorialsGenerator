// ============================================================================
// PRISMA SCHEMA
// ============================================================================
//
// Foundation models for the app:
//   1. Authentication (Better Auth)   — User, Session, Account, Verification, TwoFactor
//   2. Multi-tenant organizations     — Organization, Member, Invitation, OrganizationRole
//   3. Subscription billing            — Subscription
//   4. Feature-gate usage tracking     — UsageMetrics
//   5. Audit logging                   — ActivityLog
//
// Add your own domain models BELOW these with `organizationId` as the
// tenancy key.
//
// SOURCE OF TRUTH RULE: Prisma is the source of truth for any data shape
// it can describe. Never duplicate a database type into a TS interface.
// Import from `@/generated/prisma` or use `Prisma.<Type>` helpers.
// ============================================================================

generator client {
  provider = "prisma-client-js"
  // Generated client lives inside src/ so imports stay typed and bundler-friendly
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// BETTER AUTH — Core authentication models
// ============================================================================
//
// These models are required by Better Auth and its plugins. The shape is
// defined by Better Auth's schema generator — do NOT rename fields without
// also updating the auth config and re-running `npx @better-auth/cli generate`.
//
// SOURCE OF TRUTH KEYWORDS: User, Session, Account, Verification, TwoFactor
// ============================================================================

/// User — the primary identity record. Links to all auth credentials,
/// organization memberships, sessions, and audit logs.
model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  // Better Auth twoFactor plugin — flag indicating 2FA is enabled
  twoFactorEnabled Boolean? @default(false)

  // Better Auth admin plugin — 'admin' grants impersonation + admin endpoint access
  role       String?
  banExpires DateTime?
  banReason  String?
  banned     Boolean?  @default(false)

  // Application-level fields
  onboardingComplete Boolean @default(false)
  firstName          String?
  lastName           String?

  // Relations
  accounts         Account[]
  sessions         Session[]
  twofactors       TwoFactor[]
  members          Member[]
  invitations      Invitation[]
  activityLogs     ActivityLog[]

  // Course production domain — authorship only; SetNull keeps content when a user is removed
  coursesCreated               Course[]
  generationJobsCreated        GenerationJob[]
  lessonVersionsAuthored       LessonVersion[]
  publishingConnectionsCreated PublishingConnection[]
  coursePublicationsCreated    CoursePublication[]

  @@map("user")
}

/// Session — issued at sign-in, validated on every request.
/// `activeOrganizationId` powers the org-scoped procedure (set lazily by
/// Better Auth's organization plugin or by our session-create hook).
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  // Better Auth organization plugin — current active org for this session
  activeOrganizationId String?

  // Better Auth admin plugin — impersonation chain (admin user ID)
  impersonatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

/// Account — credential record, one per provider per user (email+password,
/// google, github, etc.). The `password` field stores the hash for email auth.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

/// Verification — short-lived tokens for email verification, password reset,
/// magic links, etc. Cleaned up automatically once consumed or expired.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

/// TwoFactor — TOTP secret + backup codes for the 2FA plugin.
model TwoFactor {
  id          String @id
  secret      String
  backupCodes String
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("twoFactor")
}

// ============================================================================
// ORGANIZATIONS — Multi-tenancy core
// ============================================================================
//
// Every domain entity in this app should hang off Organization via an
// `organizationId` foreign key. The protectedProcedure (see src/trpc/
// procedures/protected.ts) guarantees that the active organization is
// always present in ctx, so all queries can be safely scoped by tenant.
//
// SOURCE OF TRUTH KEYWORDS: Organization
// ============================================================================

/// Organization — a tenant. Owns all members, subscriptions, and domain data.
model Organization {
  id        String   @id
  name      String
  slug      String   @unique
  logo      String?
  createdAt DateTime
  metadata  String?

  // Billing — Stripe customer for this tenant. Set on first checkout / when a
  // card is added, so a free org can store a payment method before subscribing.
  // The Subscription model also carries stripeCustomerId; this is the durable
  // org-level handle used by resolveExistingStripeCustomerId (payment.service).
  stripeCustomerId String?

  // Platform admin — when true, this org is the operator's "portal" workspace.
  // getOrganizationTier short-circuits it to the hidden, unlimited `portal`
  // tier, and its members get the /portal super-admin console. Bootstrapped
  // from PORTAL_INITIAL_OWNER_EMAIL (src/lib/config/portal.ts).
  isPortalOrganization Boolean @default(false)

  // Relations
  members           Member[]
  invitations       Invitation[]
  organizationroles OrganizationRole[]
  subscriptions     Subscription[]
  usageMetrics      UsageMetrics[]
  activityLogs      ActivityLog[]

  // Course production domain (docs/10-mvp1-technical-spec.md)
  courses               Course[]
  researchDossiers      ResearchDossier[]
  modules               Module[]
  lessons               Lesson[]
  lessonVersions        LessonVersion[]
  exercises             Exercise[]
  assessmentItems       AssessmentItem[]
  aiProviders           AiProvider[]
  aiModels              AiModel[]
  capabilityRoutes      CapabilityRoute[]
  agentModelOverrides   AgentModelOverride[]
  generationJobs        GenerationJob[]
  agentTasks            AgentTask[]
  aiUsageEvents         AiUsageEvent[]
  lessonScenes          LessonScene[]
  voiceProfiles         VoiceProfile[]
  courseMaterials       CourseMaterial[]
  assets                Asset[]
  courseBooks           CourseBook[]
  publishingConnections PublishingConnection[]
  coursePublications    CoursePublication[]

  @@map("organization")
}

/// Member — links a User to an Organization with a role (owner | admin | member
/// | <custom-role>). Custom roles are defined in OrganizationRole.
///
/// SOURCE OF TRUTH KEYWORD: Member
model Member {
  id             String   @id
  organizationId String
  userId         String
  role           String
  createdAt      DateTime

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("member")
}

/// Invitation — pending invite to join an organization. Becomes a Member on
/// accept; cancellation or expiration deletes the row (hard delete only, per
/// the project's no-soft-delete rule). The mere existence of a row implies
/// "pending"; status is encoded by presence rather than a column.
model Invitation {
  id             String   @id
  organizationId String
  email          String
  role           String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  inviterId      String

  user         User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("invitation")
}

/// OrganizationRole — custom roles created per-org. ONE row per (organization,
/// role); the `permission` column stores a JSON object map of the form
/// `{ "<resource>": ["<action>", ...] }` (e.g. `{"member":["read"],"projects":
/// ["read","create"]}`). The organizationRoles router writes it; the tRPC
/// context (src/trpc/init.ts) JSON-parses it and flattens to `resource:action`
/// strings to drive requirePermission checks. The static `owner` role is NOT
/// stored here — owners get a sentinel "all access" in the context resolver.
///
/// Use this together with the permission statement built in
/// src/lib/better-auth/permissions.ts.
///
/// SOURCE OF TRUTH KEYWORD: OrganizationRole
model OrganizationRole {
  id             String    @id
  organizationId String
  role           String
  permission     String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime? @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organizationRole")
}

// ============================================================================
// BILLING — Subscription tier (drives feature gates)
// ============================================================================

/// Subscription — links an Organization to a Stripe subscription and plan tier.
/// The `plan` field MUST match a key in `PLANS` (src/lib/config/plans.ts) — e.g.
/// "free" | "starter" | "pro" | "enterprise". Resolving the org's tier reads
/// this row's plan when status is active/trialing.
///
/// SOURCE OF TRUTH KEYWORD: Subscription
model Subscription {
  id                   String    @id
  plan                 String // Must match a key in `PLANS` (src/lib/config/plans.ts)
  referenceId          String // Organization ID this subscription belongs to
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String    @default("incomplete") // incomplete|active|trialing|past_due|canceled
  periodStart          DateTime?
  periodEnd            DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  seats                Int?
  trialStart           DateTime?
  trialEnd             DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  @@map("subscription")
}

/// CardFingerprint — free-trial abuse prevention. Stores the Stripe card
/// `fingerprint` (a stable hash of the card, identical across re-tokenizations
/// and across customers) per user, with a `usedFreeTrial` flag. Before granting
/// a trial, billing checks whether this user OR any user has already used a
/// trial with the same card fingerprint. Tracking is best-effort and
/// non-critical: every read fails OPEN (allows the trial) so a Stripe/DB hiccup
/// never blocks a legitimate signup.
///
/// SOURCE OF TRUTH KEYWORD: CardFingerprint

// ============================================================================
// FEATURE GATE USAGE TRACKING
// ============================================================================

/// UsageMetrics — current consumption of a "limit" resource for an org.
/// Writes happen via incrementUsage() / decrementUsage() in
/// src/services/usage.service.ts. Reads happen via getFeatureGates() in
/// src/lib/feature-gate.ts, which combines this with the plan config to
/// compute remaining quota.
///
/// One row per (organization, featureKey). The `featureKey` column stores the
/// BARE resource key from `RESOURCES` (src/lib/resources.ts) — e.g. `"projects"`,
/// `"storage"`, `"apiCalls"`. The column name is historical; semantically it is
/// a `LimitResourceKey`.
///
/// SOURCE OF TRUTH KEYWORD: UsageMetrics
model UsageMetrics {
  id             String   @id @default(cuid())
  organizationId String
  featureKey     String // A LimitResourceKey from `RESOURCES` (src/lib/resources.ts)
  currentUsage   Int      @default(0)
  lastResetAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Composite uniqueness so each org has at most one row per featureKey
  @@unique([organizationId, featureKey])
  @@index([organizationId])
  @@map("usageMetrics")
}

// ============================================================================
// AUDIT LOG (forensic-grade)
// ============================================================================

/// ActivityLog — append-only audit trail. Written via logActivity() in
/// src/services/activity-log.service.ts inside the same transaction as the
/// handler mutation, so the audit row and the business data commit together
/// (or both roll back).
///
/// SECURITY: ipAddress and userAgent are forensic fields. They are written
/// by the server (via getRequestForensics) and MUST NEVER be returned to
/// any frontend endpoint. Reads from this table go through the
/// AUDIT_LOG_SAFE_SELECT pick which deliberately omits both fields.
///
/// SOURCE OF TRUTH KEYWORD: ActivityLog
model ActivityLog {
  id             String   @id @default(cuid())
  userId         String // Actor — the user who performed the action
  organizationId String // Tenant scope
  action         String // "create" | "update" | "delete" | <custom verb>
  entity         String // Entity type — e.g., "project", "member", "invitation"
  entityId       String? // Affected entity ID (optional for org-level actions)
  description    String? // Human-readable summary, e.g., "Renamed Project 'A' → 'B'"
  metadata       Json? // Structured before/after diff or extra context
  ipAddress      String? // FORENSIC ONLY — never exposed to frontend
  userAgent      String? // FORENSIC ONLY — never exposed to frontend
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Indexes tuned for the most common queries: org timeline, user timeline,
  // and recent-activity dashboards. Add additional indexes only when a real
  // query proves they're needed.
  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@index([action])
  @@index([entity])
  @@map("activity_log")
}

// ============================================================================
// COURSE PRODUCTION — Course State
// ============================================================================
//
// The structured course a generation produces and a user edits. Content that
// has a rich, evolving shape (lesson sections, exercise bodies, quiz answers,
// research findings, the brief) lives in Json columns whose ONLY contract is
// the Zod schemas in src/lib/types/course-content.ts — every read and write is
// validated against them. Ordering is an integer `position` (not unique, so a
// reorder can rewrite positions without transient constraint violations).
//
// SOURCE OF TRUTH KEYWORDS: Course, ResearchDossier, Module, Lesson,
//   LessonVersion, Exercise, AssessmentItem, CourseStatus, LessonStatus
// ============================================================================

/// CourseStatus — the course-level generation state machine.
/// DRAFT → RESEARCHING → CURRICULUM_REVIEW → GENERATING → REVIEW → READY; FAILED from any running state.
enum CourseStatus {
  DRAFT
  RESEARCHING
  CURRICULUM_REVIEW
  GENERATING
  REVIEW
  READY
  FAILED
}

/// LessonKind — STANDARD teaching lectures, or the course WELCOME lecture
/// (intro video: who it's for, what you'll build, how the course works).
/// The welcome lecture runs through the same script/visual/narration/video
/// pipeline but skips exercises and quizzes.
enum LessonKind {
  STANDARD
  WELCOME
}

/// LessonStatus — per-lesson production state. PLANNED rows come from the curriculum.
enum LessonStatus {
  PLANNED
  GENERATING
  GENERATED
  QA_FLAGGED
  APPROVED
}

/// VersionSource — who produced a LessonVersion.
enum VersionSource {
  AI
  USER_EDIT
  RESTORE
}

/// ExerciseLevel — blueprint §17 difficulty bands; PROJECT = module/final project.
enum ExerciseLevel {
  QUICK_CHECK
  PRACTICE
  CHALLENGE
  PROJECT
}

/// AssessmentType — blueprint §18 question types supported in MVP 1.
enum AssessmentType {
  MULTIPLE_CHOICE
  MULTIPLE_RESPONSE
  TRUE_FALSE
  SHORT_ANSWER
  FILL_BLANK
  MATCHING
  SCENARIO
}

enum AssessmentDifficulty {
  EASY
  MEDIUM
  HARD
}

/// Course — root of Course State. `brief` is a CourseBrief; goal / outcomes /
/// prerequisites / assessmentStrategy are written by the Curriculum Architect
/// and stay user-editable. `guidedApproval` = approve each lesson manually
/// instead of auto-approving on QA pass.
model Course {
  id                   String       @id @default(cuid())
  organizationId       String
  createdById          String?
  title                String
  slug                 String
  status               CourseStatus @default(DRAFT)
  brief                Json // CourseBrief
  goal                 String?
  outcomes             Json? // LearningOutcome[]
  prerequisites        String[]
  assessmentStrategy   String?
  guidedApproval       Boolean      @default(false)
  curriculumApprovedAt DateTime?
  // Landing page (Course Landing writer, docs/11 §1) — learner-facing copy
  subtitle             String?
  description          String?
  whatYouWillLearn     String[]
  requirements         String[]
  targetAudience       String[]
  // CourseQualityReport — deterministic readiness checks computed when a build finishes
  qualityReport        Json?
  // ProjectBrief — the final capstone project (brief, milestones, starter
  // files, rubric, reference solution), written by the Project Designer.
  finalProject         Json?
  // CheatSheet — condensed one-to-two page reference (Cheat Sheet Writer).
  cheatSheet           Json?
  /// Book-first courses: plan, approve and build without stopping for review.
  autopilot            Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy        User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  researchDossiers ResearchDossier[]
  modules          Module[]
  lessons          Lesson[]
  exercises        Exercise[]
  assessmentItems  AssessmentItem[]
  generationJobs   GenerationJob[]
  aiUsageEvents    AiUsageEvent[]
  assets           Asset[]
  materials        CourseMaterial[]
  book             CourseBook?
  publications     CoursePublication[]

  @@unique([organizationId, slug])
  @@index([organizationId, updatedAt])
  @@map("course")
}

/// ResearchDossier — Research Agent output, versioned and stored apart from
/// instructional content (blueprint §8). `content` is a ResearchDossier.
model ResearchDossier {
  id              String   @id @default(cuid())
  organizationId  String
  courseId        String
  version         Int
  content         Json // ResearchDossierContent
  createdByTaskId String?
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, version])
  @@map("research_dossier")
}

model Module {
  id               String   @id @default(cuid())
  organizationId   String
  courseId         String
  position         Int
  title            String
  summary          String   @default("")
  objectiveRefs    String[] // LearningOutcome ids, e.g. "LO-2"
  estimatedMinutes Int      @default(0)
  /// The course book chapter this module teaches (book-based courses only).
  bookChapterId    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course          Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  bookChapter     CourseBookChapter? @relation(fields: [bookChapterId], references: [id], onDelete: SetNull)
  lessons         Lesson[]
  exercises       Exercise[]
  assessmentItems AssessmentItem[]

  @@index([courseId, position])
  @@map("module")
}

/// Lesson — a slot in the curriculum. Holds NO content: content lives in
/// append-only LessonVersion rows. `currentVersionId` = what the editor shows;
/// `approvedVersionId` = what exports use, moved only by an explicit approval.
model Lesson {
  id                String       @id @default(cuid())
  organizationId    String
  courseId          String
  moduleId          String
  position          Int
  title             String
  objectiveRefs     String[]
  estimatedMinutes  Int          @default(0)
  status            LessonStatus @default(PLANNED)
  kind              LessonKind   @default(STANDARD)
  /// Inclusive 1-based course book pages this lesson teaches (book-based courses only).
  bookStartPage     Int?
  bookEndPage       Int?
  currentVersionId  String?      @unique
  approvedVersionId String?      @unique
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module          Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  versions        LessonVersion[]  @relation("LessonVersions")
  currentVersion  LessonVersion?   @relation("LessonCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  approvedVersion LessonVersion?   @relation("LessonApprovedVersion", fields: [approvedVersionId], references: [id], onDelete: SetNull)
  exercises       Exercise[]
  assessmentItems AssessmentItem[]
  scenes          LessonScene[]
  assets          Asset[]

  @@index([moduleId, position])
  @@index([courseId])
  @@map("lesson")
}

/// LessonVersion — append-only lesson content (blueprint §36: approved
/// content is never silently overwritten). `content` is a LessonContent.
model LessonVersion {
  id                  String        @id @default(cuid())
  organizationId      String
  lessonId            String
  version             Int
  content             Json // LessonContent
  source              VersionSource
  createdByTaskId     String?
  createdById         String?
  // Narration (step 7): WebVTT captions for the whole lecture and the
  // measured total length of the narrated video.
  captionsAssetId     String?
  narrationDurationMs Int?
  // Lecture MP4 (step 8): stills + narration joined, captions embedded.
  videoAssetId        String?
  createdAt           DateTime      @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lesson        Lesson        @relation("LessonVersions", fields: [lessonId], references: [id], onDelete: Cascade)
  captionsAsset Asset?        @relation("VersionCaptions", fields: [captionsAssetId], references: [id], onDelete: SetNull)
  videoAsset    Asset?        @relation("VersionVideo", fields: [videoAssetId], references: [id], onDelete: SetNull)
  createdBy     User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  currentFor    Lesson?       @relation("LessonCurrentVersion")
  approvedFor   Lesson?       @relation("LessonApprovedVersion")
  scenes        LessonScene[]

  @@unique([lessonId, version])
  @@map("lesson_version")
}

/// SceneType — the on-screen layout of one lecture-video scene (docs/11 §3).
/// The renderer draws only what the scene's `onScreen` spec says.
enum SceneType {
  TITLE_CARD
  TALKING_POINTS
  DIAGRAM
  CODE_WALKTHROUGH
  CODE_TYPING
  COMPARISON
  CALLOUT
  SUMMARY
  EXERCISE_PROMPT
  QUIZ_BREAK
  ILLUSTRATION
}

/// LessonScene — one scene of a lesson's video script, owned by a
/// LessonVersion so regenerating a lesson never overwrites approved media.
/// `onScreen` is the per-type SceneOnScreen spec; `narration` is written for
/// speech. `estimatedDurationMs` comes from word count until narration audio
/// exists; `durationMs` is the measured audio length (step 7).
model LessonScene {
  id                  String    @id @default(cuid())
  organizationId      String
  lessonId            String
  lessonVersionId     String
  position            Int
  type                SceneType
  narration           String
  onScreen            Json // SceneOnScreen for `type`
  emphasis            String[]
  pauseAfterMs        Int       @default(0)
  estimatedDurationMs Int       @default(0)
  durationMs          Int?
  // Rendered visuals (step 6): the 1920×1080 still of the whole scene, the
  // rendered diagram for DIAGRAM scenes, and the last render error if any.
  stillAssetId        String?
  diagramAssetId      String?
  // ILLUSTRATION scenes: the generated picture, kept so re-rendering the
  // slide never pays for (or changes) the image again.
  imageAssetId        String?
  visualError         String?
  // Narration audio (step 7); durationMs = audio length + pauseAfterMs.
  audioAssetId        String?
  createdByTaskId     String?
  createdAt           DateTime  @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lesson        Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonVersion LessonVersion @relation(fields: [lessonVersionId], references: [id], onDelete: Cascade)
  stillAsset    Asset?        @relation("SceneStill", fields: [stillAssetId], references: [id], onDelete: SetNull)
  audioAsset    Asset?        @relation("SceneAudio", fields: [audioAssetId], references: [id], onDelete: SetNull)
  diagramAsset  Asset?        @relation("SceneDiagram", fields: [diagramAssetId], references: [id], onDelete: SetNull)
  imageAsset    Asset?        @relation("SceneImage", fields: [imageAssetId], references: [id], onDelete: SetNull)

  @@unique([lessonVersionId, position])
  @@index([lessonId])
  @@map("lesson_scene")
}

/// Exercise — lesson-level practice or a module-level project. Regeneration
/// stamps `supersededAt` on the old rows instead of deleting them; the active
/// set is `supersededAt IS NULL`. `content` is an ExerciseContent.
model Exercise {
  id              String        @id @default(cuid())
  organizationId  String
  courseId        String
  moduleId        String?
  lessonId        String?
  level           ExerciseLevel
  title           String
  position        Int           @default(0)
  content         Json // ExerciseContent
  createdByTaskId String?
  supersededAt    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module       Module?      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lesson       Lesson?      @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, supersededAt])
  @@index([moduleId, supersededAt])
  @@map("exercise")
}

/// AssessmentItem — one quiz/assessment question tied to a learning objective
/// (blueprint §18). Same superseding rule as Exercise. `content` is an
/// AssessmentItemContent discriminated by `type`.
model AssessmentItem {
  id              String               @id @default(cuid())
  organizationId  String
  courseId        String
  moduleId        String?
  lessonId        String?
  objectiveRef    String
  type            AssessmentType
  difficulty      AssessmentDifficulty
  position        Int                  @default(0)
  content         Json // AssessmentItemContent
  createdByTaskId String?
  supersededAt    DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module       Module?      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lesson       Lesson?      @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, supersededAt])
  @@index([courseId, supersededAt])
  @@map("assessment_item")
}

// ============================================================================
// AI GATEWAY — providers, models, capability routing (bring-your-own-key)
// ============================================================================
//
// SECURITY: AiProvider.apiKeyCiphertext is AES-256-GCM ciphertext (key from
// AI_KEYS_ENCRYPTION_KEY). It MUST NEVER be selected into a client-facing
// response — reads go through AI_PROVIDER_SAFE_SELECT, mirroring the
// ActivityLog forensic-field rule.
//
// SOURCE OF TRUTH KEYWORDS: AiProvider, AiModel, CapabilityRoute,
//   AgentModelOverride, ProviderKind, AiCapability
// ============================================================================

/// ProviderKind — every MVP 1 provider speaks the OpenAI-compatible protocol;
/// the kind selects base-URL presets and per-provider quirks in the adapter.
enum ProviderKind {
  ALIBABA
  DEEPSEEK
  OPENAI
  OPENROUTER
  LOCAL
  CUSTOM
}

/// AiCapability — what an agent asks for instead of a model name (blueprint §23).
enum AiCapability {
  FAST_TEXT
  STRONG_REASONING
  CODING
  LONG_CONTEXT
  /// Text-to-speech (narration). Priced per 1M input characters, stored in
  /// AiModel.inputPricePerMTok; never falls back to a text model.
  TTS
  /// Reads images (scanned book pages, OCR). Never falls back to a text model.
  VISION
  /// Creates images (lecture illustrations). Priced per image, stored in
  /// AiModel.inputPricePerMTok; never falls back to a text model.
  IMAGE_GENERATION
}

model AiProvider {
  id               String       @id @default(cuid())
  organizationId   String
  name             String
  kind             ProviderKind
  baseUrl          String
  apiKeyCiphertext String? // null for keyless local endpoints
  apiKeyLast4      String?
  isEnabled        Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  models        AiModel[]
  aiUsageEvents AiUsageEvent[]

  @@unique([organizationId, name])
  @@map("ai_provider")
}

/// AiModel — a model exposed by a provider. Prices are per million tokens in
/// USD and user-editable; they drive every AiUsageEvent.costMicros.
model AiModel {
  id                 String         @id @default(cuid())
  organizationId     String
  providerId         String
  modelId            String // provider's own id, e.g. "qwen-max", "deepseek-chat"
  displayName        String
  capabilities       AiCapability[]
  inputPricePerMTok  Decimal        @default(0) @db.Decimal(12, 6)
  outputPricePerMTok Decimal        @default(0) @db.Decimal(12, 6)
  supportsJsonSchema Boolean        @default(false)
  contextWindow      Int?
  isEnabled          Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       AiProvider           @relation(fields: [providerId], references: [id], onDelete: Cascade)
  primaryRoutes  CapabilityRoute[]    @relation("CapabilityRoutePrimary")
  fallbackRoutes CapabilityRoute[]    @relation("CapabilityRouteFallback")
  agentOverrides AgentModelOverride[]
  aiUsageEvents  AiUsageEvent[]

  @@unique([providerId, modelId])
  @@index([organizationId])
  @@map("ai_model")
}

/// CapabilityRoute — per-workspace capability → model mapping. Presets
/// (Economy / Balanced / Best Quality) write these rows.
model CapabilityRoute {
  id              String       @id @default(cuid())
  organizationId  String
  capability      AiCapability
  modelId         String
  fallbackModelId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  model         AiModel      @relation("CapabilityRoutePrimary", fields: [modelId], references: [id], onDelete: Cascade)
  fallbackModel AiModel?     @relation("CapabilityRouteFallback", fields: [fallbackModelId], references: [id], onDelete: SetNull)

  @@unique([organizationId, capability])
  @@map("capability_route")
}

/// AgentModelOverride — optional per-agent model pin (blueprint §22); wins
/// over the capability route. `agentId` is a key of the agent registry.
model AgentModelOverride {
  id             String   @id @default(cuid())
  organizationId String
  agentId        String
  modelId        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  model        AiModel      @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([organizationId, agentId])
  @@map("agent_model_override")
}

// ============================================================================
// GENERATION — jobs, the agent task DAG (also the work queue), cost ledger
// ============================================================================
//
// AgentTask IS the queue: the worker claims READY rows whose runAfter has
// passed with SELECT … FOR UPDATE SKIP LOCKED. Rows are created inside the
// enqueueing procedure's transaction, so a rolled-back mutation never leaves
// a phantom job. `dependsOn` holds sibling task KEYS (unique per job).
//
// SOURCE OF TRUTH KEYWORDS: GenerationJob, AgentTask, AiUsageEvent, JobKind,
//   JobStatus, TaskStatus, TaskQueue, CostLedger
// ============================================================================

enum JobKind {
  PLAN_COURSE
  BUILD_COURSE
  REGENERATE
  RENDER_VISUALS
  RENDER_NARRATION
  RENDER_VIDEO
  BUILD_MATERIALS
  EXPORT_COURSE
  EXPORT_SCORM
  READ_BOOK
  PUBLISH_COURSE
}

enum JobStatus {
  QUEUED
  RUNNING
  AWAITING_APPROVAL
  SUCCEEDED
  FAILED
  CANCELLED
}

/// TaskStatus — BLOCKED (deps pending) → READY → RUNNING → SUCCEEDED | FAILED;
/// SKIPPED when a dependency failed for good; CANCELLED with its job.
enum TaskStatus {
  BLOCKED
  READY
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  CANCELLED
}

model GenerationJob {
  id             String    @id @default(cuid())
  organizationId String
  courseId       String
  createdById    String?
  kind           JobKind
  status         JobStatus @default(QUEUED)
  scope          Json? // GenerationScope — what a REGENERATE job targets
  totalTasks     Int       @default(0)
  completedTasks Int       @default(0)
  failedTasks    Int       @default(0)
  costMicros     BigInt    @default(0) // micro-USD, rolled up from AiUsageEvent
  error          String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy     User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  tasks         AgentTask[]
  aiUsageEvents AiUsageEvent[]

  @@index([courseId, createdAt])
  @@index([organizationId, status])
  @@map("generation_job")
}

model AgentTask {
  id             String     @id @default(cuid())
  organizationId String
  jobId          String
  key            String // unique within the job, e.g. "lessonWriter:<lessonId>"
  agentId        String // key of the agent registry (src/lib/agents)
  status         TaskStatus @default(BLOCKED)
  dependsOn      String[] // sibling task keys
  attempt        Int        @default(0)
  maxAttempts    Int        @default(3)
  input          Json // AgentTaskInput — ids only, content is loaded at run time
  output         Json?
  error          String?
  errorKind      String? // AiErrorKind from the gateway
  runAfter       DateTime   @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  startedAt      DateTime?
  finishedAt     DateTime?
  costMicros     BigInt     @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job           GenerationJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  aiUsageEvents AiUsageEvent[]

  @@unique([jobId, key])
  @@index([status, runAfter])
  @@index([jobId])
  @@map("agent_task")
}

/// AiUsageEvent — append-only cost ledger, one row per provider call
/// (success or failure). Course/job/task/model links are SetNull so spend
/// history survives deletions; provider/model names are snapshotted.
model AiUsageEvent {
  id             String       @id @default(cuid())
  organizationId String
  courseId       String?
  lessonId       String?
  jobId          String?
  taskId         String?
  providerId     String?
  modelId        String?
  providerName   String
  modelName      String
  agentId        String?
  capability     AiCapability
  inputTokens    Int          @default(0)
  outputTokens   Int          @default(0)
  costMicros     BigInt       @default(0)
  latencyMs      Int          @default(0)
  success        Boolean
  errorKind      String?
  createdAt      DateTime     @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course       Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  job          GenerationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  task         AgentTask?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  provider     AiProvider?    @relation(fields: [providerId], references: [id], onDelete: SetNull)
  model        AiModel?       @relation(fields: [modelId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([courseId])
  @@index([jobId])
  @@map("ai_usage_event")
}

// ============================================================================
// MEDIA ASSETS — files in object storage (docs/11 §4)
// ============================================================================
//
// One row per stored file (rendered stills, diagrams, later narration audio,
// lesson videos, captions, downloads). The bytes live in the StorageAdapter
// (local disk in development, S3-compatible in production) under
// `storageKey`; files are served only through /api/assets/[assetId], which
// checks the viewer belongs to the owning organization. `bytes` is the source
// of truth for storage usage (summed per organization) — the generic
// UsageMetrics counter is a 32-bit Int and cannot hold byte totals.
//
// SOURCE OF TRUTH KEYWORDS: Asset, AssetKind, storageKey, StorageAdapter
// ============================================================================

enum AssetKind {
  IMAGE
  SVG
  AUDIO
  VIDEO
  CAPTIONS
  DOCUMENT
  ARCHIVE
}

model Asset {
  id             String    @id @default(cuid())
  organizationId String
  courseId       String
  lessonId       String?
  kind           AssetKind
  storageKey     String    @unique
  mimeType       String
  bytes          Int
  width          Int?
  height         Int?
  durationMs     Int?
  sourceTaskId   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course           Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson           Lesson?         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  stillForScenes   LessonScene[]   @relation("SceneStill")
  audioForScenes   LessonScene[]   @relation("SceneAudio")
  captionsFor      LessonVersion[] @relation("VersionCaptions")
  materialFor      CourseMaterial?
  videoFor         LessonVersion[] @relation("VersionVideo")
  diagramForScenes LessonScene[]   @relation("SceneDiagram")
  imageForScenes   LessonScene[]   @relation("SceneImage")
  bookFor          CourseBook?

  @@index([organizationId])
  @@index([courseId])
  @@map("asset")
}

/// VoiceProfile — how narration sounds (blueprint §14): the provider voice
/// id, speaking speed, and style instructions. The TTS *model* is chosen by
/// the TTS capability route; the profile only picks the voice on it. One
/// default profile per workspace for now (per-course voices later).
///
/// SOURCE OF TRUTH KEYWORDS: VoiceProfile, narration voice, TTS voice
model VoiceProfile {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  voice          String
  speed          Float    @default(1)
  instructions   String   @default("")
  isDefault      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("voice_profile")
}

// ============================================================================
// COURSE MATERIALS — downloadable resources (docs/11 §1)
// ============================================================================
//
// SOURCE OF TRUTH KEYWORDS: CourseMaterial, MaterialKind, MaterialAudience,
//   workbook, answer key, cheat sheet, glossary, source code
// ============================================================================

enum MaterialKind {
  WORKBOOK
  ANSWER_KEY
  CHEAT_SHEET
  GLOSSARY
  SOURCE_CODE
  COURSE_PACKAGE
  SCORM_PACKAGE
}

/// LEARNER materials appear in the learner view; INSTRUCTOR materials (the
/// answer key) only in the studio.
enum MaterialAudience {
  LEARNER
  INSTRUCTOR
}

/// CourseMaterial — one current file per (course, kind); rebuilding replaces
/// the file and its Asset in place.
model CourseMaterial {
  id             String           @id @default(cuid())
  organizationId String
  courseId       String
  kind           MaterialKind
  audience       MaterialAudience
  title          String
  assetId        String           @unique
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  asset        Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([courseId, kind])
  @@map("course_material")
}

// ============================================================================
// SOURCE OF TRUTH KEYWORDS: CourseBook, CourseBookChapter, course book,
//   study text, book chapters, book pages, book-based course
// ============================================================================

/// CourseBook — the book a course is built from (e.g. an exam study text PDF).
/// The original file is kept as an Asset; its text lives in the chapters.
model CourseBook {
  id             String     @id @default(cuid())
  organizationId String
  courseId       String     @unique
  assetId        String     @unique
  title          String
  fileName       String
  pageCount      Int
  /// READING while a scanned book's pages are being read by a vision model.
  status         BookStatus @default(READY)
  /// Pages read so far (scanned books).
  pagesRead      Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course       Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  asset        Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  chapters     CourseBookChapter[]
  scannedPages CourseBookPage[]

  @@index([organizationId])
  @@map("course_book")
}

/// CourseBookChapter — one chapter: its page range, its topics (sub-headings
/// with pages, Json BookTopic[]) and the extracted text of each page. Only
/// `selected` chapters become course sections.
model CourseBookChapter {
  id        String   @id @default(cuid())
  bookId    String
  position  Int
  title     String
  startPage Int
  endPage   Int
  topics    Json
  pages     String[]
  selected  Boolean  @default(true)

  book    CourseBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  modules Module[]

  @@unique([bookId, position])
  @@map("course_book_chapter")
}

enum BookStatus {
  READING
  READY
}

/// CourseBookPage — the text a vision model read from one page of a scanned
/// book. Temporary: the book assembler turns these into chapters, then
/// deletes them.
model CourseBookPage {
  id     String @id @default(cuid())
  bookId String
  page   Int
  text   String

  book CourseBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, page])
  @@map("course_book_page")
}

// ── Publishing: send finished courses to outside platforms ───────────────

/// The outside platforms a course can be published to with one click.
/// Platforms whose APIs cannot receive course content (Moodle without a
/// plugin, Thinkific, Teachable, Udemy) are export guides, not connections.
enum PublishingPlatform {
  YOUTUBE
  GOOGLE_CLASSROOM
  CANVAS
  VIMEO
  GOOGLE_DRIVE
  LEARNDASH
  /// The workspace's own school on a hosted install (desktop → web), via a school API key.
  SCHOOL
}

enum PublicationStatus {
  QUEUED
  RUNNING
  PUBLISHED
  FAILED
}

/// PublishingConnection — one connected account on an outside platform (a
/// YouTube channel, a Google Classroom teacher, a Canvas site). Tokens or
/// API keys live encrypted in `credentialsCiphertext` and never reach the
/// browser.
model PublishingConnection {
  id                    String             @id @default(cuid())
  organizationId        String
  platform              PublishingPlatform
  name                  String
  accountId             String?
  baseUrl               String?
  credentialsCiphertext String
  createdById           String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  publications CoursePublication[]

  @@index([organizationId])
  @@map("publishing_connection")
}

/// CoursePublication — a course sent to one connection. Re-publishing reuses
/// the row, and PublishedItem records what already exists on the platform,
/// so a retry continues instead of uploading duplicates.
model CoursePublication {
  id             String             @id @default(cuid())
  organizationId String
  courseId       String
  connectionId   String
  platform       PublishingPlatform
  status         PublicationStatus  @default(QUEUED)
  options        Json
  externalId     String?
  externalUrl    String?
  itemsDone      Int                @default(0)
  itemsTotal     Int                @default(0)
  lastJobId      String?
  error          String?
  publishedAt    DateTime?
  createdById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course       Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  connection   PublishingConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  createdBy    User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items        PublishedItem[]

  @@unique([courseId, connectionId])
  @@index([organizationId])
  @@index([lastJobId])
  @@map("course_publication")
}

/// PublishedItem — one thing created on the platform for a publication
/// (`key` like "lecture:<lessonId>:video"), with its id there.
model PublishedItem {
  id            String   @id @default(cuid())
  publicationId String
  key           String
  externalId    String
  externalUrl   String?
  createdAt     DateTime @default(now())

  publication CoursePublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([publicationId, key])
  @@map("published_item")
}

// ============================================================================
// SOURCE OF TRUTH KEYWORDS: School, StudentAccessMode, SchoolLayout,
//   SchoolCourse, Student, StudentSession, StudentToken, StudentInvitation,
//   EnrollmentLink, Enrollment, ProgressItem, AssessmentAttempt, Certificate,
//   SchoolApiKey, student portal, learner records, multi tenant isolation
//
// The student side of a workspace. Every row carries organizationId and
// cascades with the organization, so one organization's students, enrollments
// and learning records can never be read through another's school. Students
// are NOT Better Auth users: an account belongs to one organization, so the
// same email can study at two schools as two separate accounts.
// ============================================================================

/// How an organization's students reach its courses (chosen at onboarding,
/// changeable in Settings → Student access).

/// School — one per organization: access mode, branding and address.
/// `slug` is the subdomain (<slug>.<APP_DOMAIN>) and the /school/<slug> path.

/// SchoolCourse — whether a course is listed in the school and who may enroll.

/// Student — a learner account inside ONE organization. passwordHash is null
/// until an invited student sets a password.

/// StudentSession — sign in session; only a SHA-256 hash of the cookie token is stored.

/// StudentToken — single use email link (password reset); hash only.

/// StudentInvitation — staff invite by email; accepting creates (or reuses)
/// the student, sets the password and enrolls them in `courseIds`.

/// EnrollmentLink — shareable link that enrolls whoever signs up through it.

/// Enrollment — a student in a course.

/// ProgressItem — one finished player item: a lecture id or "project".
/// Quizzes count through AssessmentAttempt instead.

/// AssessmentAttempt — a graded section quiz or final assessment, marked on
/// the server (answers never reach the browser before submission).

/// Certificate — issued once a course is complete; `code` verifies it publicly.
/// Names are snapshots so later renames do not change an issued certificate.

/// SchoolApiKey — server to server key for external enrollment; hash only.
