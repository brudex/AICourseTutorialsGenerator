{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Penrose Studio",
  "version": "0.1.15",
  "identifier": "com.penrose.studio",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Penrose Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "Education",
    "shortDescription": "Turn a topic or a course book into a full video course.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/node"],
    "resources": { "../build/app": "app" }
  }
}
